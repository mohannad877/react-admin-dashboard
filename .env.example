# بيئة النشر (development, staging, production)
VITE_VERCEL_ENV=development

# مصدر البيانات: "json-server" للتطوير المحلي، "supabase" للإنتاج
VITE_DATA_SOURCE=json-server

# رابط الـ API (JSON Server - للتطوير المحلي فقط)
VITE_API_URL=http://localhost:3001

# ========================
# 🔥 Firebase Authentication
# ========================
# احصل عليها من: https://console.firebase.google.com > Project Settings > General > Your Apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ========================
# 🗄️ Supabase Database
# ========================
# احصل عليها من: https://supabase.com > Project > Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ========================
# 📊 مراقبة وتحليلات
# ========================
VITE_SENTRY_DSN=
VITE_GA_ID=
