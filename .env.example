# بيئة النشر (development, staging, production)
VITE_VERCEL_ENV=development

# رابط الـ API (تلقائياً هو http://localhost:3001 للتطوير)
VITE_API_URL=http://localhost:3001

# مفتاح تتبع Sentry لتسجيل الأخطاء (احصل عليه من sentry.io)
VITE_SENTRY_DSN=

# مفتاح تتبع Google Analytics (يبدأ بـ G-)
VITE_GA_ID=
