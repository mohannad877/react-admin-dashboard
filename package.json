{
  "name": "react-admin-dashboard",
  "version": "2.0.0",
  "private": true,
  "description": "Professional Interactive Admin Dashboard with Firebase Auth & Supabase",
  "author": "Mohannad Nabil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohannad877/react-admin-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/mohannad877/react-admin-dashboard/issues"
  },
  "homepage": "https://github.com/mohannad877/react-admin-dashboard#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "json-server --watch public/db.json --port 3001",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "lighthouse": "lhci autorun",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@sentry/react": "^10.51.0",
    "@sentry/vite-plugin": "^5.2.1",
    "@supabase/supabase-js": "^2.105.3",
    "axios": "^1.16.0",
    "firebase": "^12.12.1",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-ga4": "^3.0.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.6",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "json-server": "^1.0.0-beta.15",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
